+          -mindepth 1 -maxdepth 1 -print -quit)" ]; then printf ''refusing to reuse non-empty artifact
+          directory: /profile-output/phase6-gemma4-20260726-132018\n'' >&2; exit 73; fi; mkdir -p /profile-output/phase6-gemma4-20260726-132018
+          && chmod 0777 /profile-output/phase6-gemma4-20260726-132018'
