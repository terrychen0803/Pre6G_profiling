+          /opt/profiler/nsys/target-linux-sbsa-armv8/nsys profile   --trace=cuda,nvtx,osrt   --sample=none   --cpuctxsw=none   --force-overwrite=true   --output=/profile-output/phase6-gemma4-20260726-132018/profile   "$@"
+          application_exit_code=$?
+          set -e
+          if [ -e "$report" ]; then
+            set -- $(sha256sum "$report")
+            printf '%s\n' "$1" > /profile-output/phase6-gemma4-20260726-132018/.expected-sha256
+          fi
+          printf '%s\n' "$application_exit_code" > /profile-output/phase6-gemma4-20260726-132018/.application-finished
+          exit "$application_exit_code"
